# --- Окружение ---
APP_ENV=production

# --- Логирование ---
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Домен / TLS ---
DOMAIN=fppzo.ru
LETSENCRYPT_EMAIL=pravdin.m16@yandex.ru

# --- База данных (PostgreSQL) ---
# Внутри docker-compose host = postgres (см. service name).
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/ai_tutor
DATABASE_ECHO=false

# --- Параметры контейнера Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_tutor

# --- HTTP-сервер ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SESSION_COOKIE=ai_trainer_session

# --- Admin panel ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# --- LLM: GigaChat ---
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_CORP
GIGACHAT_MODEL=GigaChat-2-Pro
GIGACHAT_TIMEOUT_SECONDS=30
GIGACHAT_MAX_RETRIES=3

# === SaluteSpeech ===
SALUTESPEECH_API_KEY=
SALUTESPEECH_SCOPE=SALUTE_SPEECH_CORP
SALUTESPEECH_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
SALUTESPEECH_TTS_URL=https://smartspeech.sber.ru/rest/v1/text:synthesize
SALUTESPEECH_STT_URL=https://smartspeech.sber.ru/rest/v1/speech:recognize
SALUTESPEECH_VOICE=Tur_24000
SALUTESPEECH_FORMAT=wav16
SALUTESPEECH_CA_BUNDLE=russian_trusted_root_ca.cer
SALUTESPEECH_ENABLED=true

# Кэш TTS
TTS_CACHE_DIR=var/tts
TTS_CACHE_TTL_SECONDS=201600
TTS_CACHE_CLEANUP_INTERVAL_SECONDS=21600

# Промпты
PROMPTS_PATH=var/prompts/templates.json
